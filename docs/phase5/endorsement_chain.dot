digraph chain {
  rankdir=LR; bgcolor="white"; pad=0.3; nodesep=0.5; ranksep=0.55;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, color="#1f6b3e", fillcolor="#f0f7f2", penwidth=1.4, margin="0.18,0.10"];
  edge [fontname="Helvetica", fontsize=10, color="#3d434b"];
  draft [label="Draft\nTeam Lead / attendees (B17)"];
  sub [label="Submitted\nDivision Head"];
  div [label="Division endorsed\nDeputy Director"];
  dep [label="Deputy verified\nDirector"];
  end [label="Director endorsed", fillcolor="#1f6b3e", fontcolor="white"];
  ret [label="Returned\nto the submitter\n(remark pinned)", color="#c53030", fillcolor="#fef2f2"];
  draft -> sub [label="submit"];
  sub -> div [label="endorse"];
  div -> dep [label="endorse"];
  dep -> end [label="endorse"];
  sub -> ret [label="return + remark", color="#c53030", fontcolor="#c53030", style=dashed];
  div -> ret [color="#c53030", style=dashed];
  dep -> ret [color="#c53030", style=dashed];
  ret -> sub [label="fix + re-submit (v+1)", color="#2b6cb0", fontcolor="#2b6cb0"];
  sub -> sub [label="add content", color="#848b95", fontcolor="#626973"];
  {rank=same; sub; ret}
}

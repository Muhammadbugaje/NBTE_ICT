digraph stages {
  rankdir=TB; bgcolor="white"; pad=0.3; nodesep=0.4; ranksep=0.42;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, color="#1f6b3e", fillcolor="#f0f7f2", penwidth=1.4, margin="0.18,0.10"];
  edge [fontname="Helvetica", fontsize=10, color="#3d434b"];
  s8 [label="Stage 8 · Visit details\nDesk officer enters dates and team lead"];
  map [label="Availability Finder (§9)\nbook → Edit QA Mapping → second officer confirms", fillcolor="#fff7ed", color="#c2410c"];
  s10 [label="Stage 10 · ES approves the visit\n→ Inspection created (team from personnel + mappings)"];
  s11 [label="Stage 11 · Pay Officer releases funds"];
  vis [label="Team Lead: Mark the visit completed\n→ Post-visit personnel (who attended)\n→ inspection closed → Service records", fillcolor="#eef0f2", color="#3d434b"];
  s12 [label="Stage 12 · Post-visit report (one per programme)\nTeam → Division Head → Deputy Director → Director"];
  s13 [label="Stage 13 · Directorate recommendation per programme"];
  s14 [label="Stage 14 · CQAC recommendation …"];
  ovr [label="Override post-visit personnel\n(Team Lead + second officer)\n→ compensating service rows", fillcolor="#fef2f2", color="#c53030"];
  s8 -> map [style=dashed]; map -> s10 [style=dashed];
  s8 -> s10 [label="stage 9: Director confirms"];
  s10 -> s11 -> s12;
  s10 -> vis [style=dashed, label="after the visit"];
  vis -> s12 [style=dashed, label="opens writing (B17)"];
  vis -> ovr [style=dotted];
  s12 -> s13 [label="last report director-endorsed\n(automatic)"];
  s13 -> s14 [label="approve"];
  s13 -> s12 [label="return: reports go back\nto their writers", color="#c53030", fontcolor="#c53030", style=dashed];
}

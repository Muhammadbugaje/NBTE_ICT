# === Django core ===
SECRET_KEY=change-me-generate-with-django
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,thanklessly-skyborne-miyoko.ngrok-free.dev

# === Database ===
# Leave blank in dev to use SQLite. Required in production.
# Postgres: postgres://user:pass@host:5432/nbte_ict
# MySQL:    mysql://user:pass@host:3306/nbte_ict?charset=utf8mb4
DATABASE_URL=

# === Cache & Celery ===
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
# Dev only: run Celery tasks inline (no Redis/worker needed).
# Set to False to exercise the real broker path.
CELERY_EAGER=True

# === Site identity ===
SITE_URL=http://localhost:8000
SITE_NAME=NBTE ICT Directorate
DEFAULT_FROM_EMAIL=NBTE ICT <no-reply@localhost>

# === File storage ===
# Absolute paths in production. Blank = BASE_DIR defaults.
MEDIA_ROOT=
PROTECTED_MEDIA_ROOT=
# True in production (behind nginx with X-Accel-Redirect). False in dev.
USE_X_ACCEL_REDIRECT=False

DEFAULT_FROM_EMAIL=NBTE ICT <yolo35789bugaje@gmail.com>
# === Email providers ===
# Brevo (primary): app.brevo.com → SMTP & API → API Keys
BREVO_API_KEY=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
# Gmail (fallback): use an App Password, NOT your account password.
# https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# === Email branding ===

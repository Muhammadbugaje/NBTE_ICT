# Copy this file to .env for local development. Keep credentials blank until
# you configure a provider. Never commit .env or put production secrets here.

DJANGO_SETTINGS_MODULE=nbte_ict.settings.dev
DEBUG=True
SECRET_KEY=change-me-use-a-long-random-secret-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,.localhost
SITE_NAME=NBTE ICT Directorate
SITE_URL=http://localhost:8000
DEFAULT_FROM_EMAIL=NBTE ICT <no-reply@localhost>
CSRF_TRUSTED_ORIGINS=

# Development mail uses the project's provider engine. Set
# QA_EMAIL_DELIVERY=console for a local, log-only run. Uncomment only to
# override Django's direct mail.
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
BREVO_API_KEY=
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_LOGO_URL=
QA_EMAIL_DELIVERY=queue

# These are required in production. Generate unique values; do not reuse the
# development placeholder.
FIELD_ENCRYPTION_KEY=
PAYMENT_QR_SIGNING_KEY=
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_EAGER=True
SECURE_SSL_REDIRECT=False
USE_X_ACCEL_REDIRECT=False

# Optional paths and service configuration.
ADMIN_ALLOWED_IPS=
INTERNAL_HOST=localhost
QA_PORTAL_HOST=qa.localhost
QA_PORTAL_URL=http://qa.localhost:8000
QA_SCOPING_STRICT=True
SERVE_FILES_LOCALLY=True
MEDIA_ROOT=
PROTECTED_MEDIA_ROOT=
DB_BACKUP_DIR=
BACKUP_STAGING_DIR=
BACKUP_PG_BIN_DIR=
FCM_SERVICE_ACCOUNT_FILE=
VOICE_TRANSCRIBE_BACKEND=
VOICE_WHISPER_MODEL=small

# Development database: sqlite (default) or url.
# To connect to Aiven locally, set DATABASE_BACKEND=url and put Aiven's
# PostgreSQL service URI in DATABASE_URL. Production settings always use
# DATABASE_URL and ignore DATABASE_BACKEND.
DATABASE_BACKEND=sqlite
DATABASE_URL=

# Publicly reachable QA portal base URL; provider callbacks need HTTPS.
# For production, replace with your public HTTPS QA portal address.
# QA_PORTAL_URL=https://qa.example.test
PAYMENT_VERIFY_BASE_URL=https://qa.example.test/verify/

# Disable the removed in-app payment simulator.
QA_PAYMENTS_SIMULATE=False

# Configure only after obtaining provider credentials through an approved channel.
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Register this callback in Paystack:
# https://qa.example.test/payments/webhooks/paystack/

# Replace these with the endpoint and credentials assigned to your Remita account.
REMITA_API_PATH=/exapp/api/v1/send/api

REMITA_BASE_URL=
REMITA_MERCHANT_ID=
REMITA_API_KEY=
REMITA_SERVICE_TYPE_ID=

# Keep these blank until authorized credentials are issued by the provider.
REMITA_API_TOKEN=
REMITA_WEBHOOK_TOKEN=
REMITA_WEBHOOK_ALLOWED_IPS=

# Register this callback with Remita:
# https://qa.example.test/payments/webhooks/remita/?token=<your-webhook-token>

# Set only for production deployments after all listed gateway keys are
# configured. Do not put secret keys in ConfigEntry or source control.
PAYMENTS_GATEWAYS=
